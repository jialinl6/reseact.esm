      "description": "GEOS-FP HFLUX -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.CLOUD",
      "to": "Transport3D.F_CLOUD",
      "transform": "param_to_var",
      "description": "GEOS-FP CLOUD -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.PFLCU",
      "to": "Transport3D.F_PFLCU",
      "transform": "param_to_var",
      "description": "GEOS-FP PFLCU -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.PFLLSAN",
      "to": "Transport3D.F_PFLLSAN",
      "transform": "param_to_var",
      "description": "GEOS-FP PFLLSAN -> the native-slice deposition driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.QV",
      "to": "Transport3D.F_QV",
      "transform": "param_to_var",
      "description": "GEOS-FP I3 QV -> the first-level height (Zagl) driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.T2M",
      "to": "Transport3D.F_T2M",
      "transform": "param_to_var",
      "description": "GEOS-FP A1 T2M -> the first-level height (Zagl) driver."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.QV2M",
      "to": "Transport3D.F_QV2M",
      "transform": "param_to_var",
      "description": "GEOS-FP A1 QV2M -> the first-level height (Zagl) driver."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Tc",
      "to": "SuperFast.T",
      "transform": "param_to_var",
      "description": "Per-cell GEOS-FP temperature -> SuperFast's scalar T param. param_to_var carries the [lon,lat,lev] shape so the pointwise lift indexes it per cell; the rate constants then vary with the real 3-D temperature field."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Pc",
      "to": "SuperFast.P",
      "transform": "param_to_var",
      "description": "Per-cell hybrid mid-layer pressure -> SuperFast's scalar P param."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.H2Oc",
      "to": "SuperFast.H2O",
      "transform": "param_to_var",
      "description": "Per-cell water vapour -> SuperFast's H2O constant-species reservoir, matching GasChem.jl's couple2(SuperFastCoupler, GEOSFPCoupler), which param_to_var's :T, :P AND :H2O together. Without this the mechanism and the photolysis would disagree about humidity: H2O enters SuperFast through H2O + NO2 -> 0.5 HNO3 and through the water enhancement of HO2 + HO2 -> H2O2."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.lat_c",
      "to": "FastJX.lat",
      "transform": "param_to_var",
      "description": "Per-cell latitude (deg) -> FastJX.lat. FastJX (jialinl6/GasChemMTK.jl@37792b29 (branch superfast-gas-only)) computes the solar zenith angle itself from lat, long and the UTC clock t + t_ref (NOAA Spencer equation of time, the same chain as GasChem's FastJX), as upstream couple2(FastJXCoupler, GEOSFPCoupler) maps f.lat ~ rad2deg(g.lat). Its calendar runs datetime.* on t + t_ref, which EarthSciAST evaluates as branch-free arithmetic (ess-traced-datetime, 2026-08-06), so it takes the solver time and traces under Reactant, as NEIRegrid's local-hour clock already does."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.lon_c",
      "to": "FastJX.long",
      "transform": "param_to_var",
      "description": "Per-cell longitude (deg) -> FastJX.long (upstream f.long ~ rad2deg(g.lon))."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.t_ref",
      "to": "FastJX.t_ref",
      "transform": "param_to_var",
      "description": "Model epoch (2016-01-01T00:00:00Z) -> FastJX.t_ref, so FastJX's t_utc = t + t_ref is the UTC clock. Upstream sets t_ref from the domain's start time; here t is already seconds since the epoch."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Tc",
      "to": "FastJX.T",
      "transform": "param_to_var",
      "description": "Per-cell GEOS-FP temperature -> FastJX's scalar T param. The SAME field SuperFast.T reads, so cross sections, quantum yields and rate constants all see one temperature. T enters every sigma_X / phi_O31D interp.linear and the O(1D) quenching rates."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Pc",
      "to": "FastJX.P",
      "transform": "param_to_var",
      "description": "Per-cell hybrid mid-layer pressure -> FastJX's scalar P param. Sets the air number density used by the O(1D) quenching balance (and would be one axis of the actinic-flux lookup in the interpolated Fast-JX variant)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.H2Oc",
      "to": "FastJX.H2O",
      "transform": "param_to_var",
      "description": "Per-cell water vapour -> FastJX's H2O param, matching GasChem.jl's couple2(FastJXCoupler, GEOSFPCoupler). Sets j_O31D_adj = RO1DplH2O/RO1D and hence the effective j_o32OH."
    },
    {
      "type": "variable_map",
