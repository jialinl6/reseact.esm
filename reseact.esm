    },
    {
      "type": "operator_compose",
      "systems": [
        "SuperFastEmissionSource",
        "SuperFast"
      ],
      "description": "Add the NEI2016 emission source terms onto the SuperFast species ODEs. SuperFastEmissionSource carries D(SuperFast.X) ~ +e_X equations; operator_compose sums them into the mechanism's own tendencies, mirroring SuperFastDepositionSink one entry above. Species mapping (NO, NO2, CO, ISOP, FORM->CH2O) and the 1e9*MW_air/MW_X unit factors are GasChem.jl couple2(SuperFastCoupler, NEI2016MonthlyEmisCoupler) verbatim; CH4 is omitted because it is a fixed species in SuperFast, and NEI's SO2/SULF have no SuperFast counterpart."
    },
    {
      "type": "operator_compose",
      "systems": [
        "SuperFast",
        "Transport3D"
      ],
      "lifting": "pointwise",
      "description": "Lift the 0-D SuperFast mechanism onto the 7x7x7 grid and add each species' PPM advection contribution to its reaction tendency. pointwise lifting evaluates the network independently per cell; the merged reaction+advection state ODEs are array-ified by the flattener's lift. Only the 12 non-constant species lift — O2/CH4/H2O are constant:true reservoirs with no ODE, so they broadcast into the rates instead."
    }
  ],
  "reaction_systems": {
    "SuperFast": {
      "ref": "../EarthSciModels/components/gaschem/superfast.esm"
    }
  }
}
