      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
    {
      "type": "variable_map",
      "from": "Transport3D.Zagl",
      "to": "DryDepositionGas.z",
      "transform": "param_to_var",
      "description": "Wesley (1989) dry-deposition driver, matching AtmosphericDeposition.jl couple2(DryDepositionGasCoupler, GEOSFPCoupler)."
    },
