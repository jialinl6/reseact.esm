    },
    {
      "type": "variable_map",
      "from": "LandUseRemap.f_wetland",
      "to": "DryDepositionGas.f_wetland",
      "transform": "param_to_var",
      "description": "Area-averaged class-9 fraction -> DryDepositionGas.f_wetland, as jialinl6/DepositionMTK.jl@cbe7d7db (branch superfast-gas-only) binds d.f_wetland ~ landuse_frac_at(gp.lon, gp.lat, 9) on the remapped grid."
    },
    {
      "type": "variable_map",
      "from": "LandUseRemap.f_rangeag",
      "to": "DryDepositionGas.f_rangeag",
      "transform": "param_to_var",
      "description": "Area-averaged class-10 fraction -> DryDepositionGas.f_rangeag, as jialinl6/DepositionMTK.jl@cbe7d7db (branch superfast-gas-only) binds d.f_rangeag ~ landuse_frac_at(gp.lon, gp.lat, 10) on the remapped grid."
    },
    {
      "type": "variable_map",
      "from": "LandUseRemap.f_rockyshrubs",
      "to": "DryDepositionGas.f_rockyshrubs",
      "transform": "param_to_var",
