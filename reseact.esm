        "t_utc": {
          "type": "unknown",
          "units": "s",
          "description": "Absolute UTC time (Unix s) = t + t_ref. Selects the calendar month whose totals days_in_month normalises -- a property of the FILE, so it deliberately carries no timezone offset (unlike t_local_utc)."
        },
        "month_utc": {
          "type": "unknown",
          "units": "1",
          "description": "Calendar month 1..12 of the current UTC time."
        },
        "is_leap_year_utc": {
          "type": "unknown",
          "units": "1",
          "description": "1 if the current UTC year is a leap year, else 0."
        },
        "days_in_month": {
          "type": "unknown",
          "units": "1",
          "description": "Days in the current calendar month, leap-aware. The EPA gridded-merge monthly files store a month's total on one 24-hour TSTEP, so without this every model day would emit a full month and the run would over-emit by ~30x (EarthSciData.jl issue #209 / PR #210). Table lookup because EarthSciAST has no datetime.daysinmonth."
        },
        "lonc": {
          "type": "unknown",
          "units": "deg",
          "description": "Longitude of each target cell CENTRE, lon_i = lon0_deg + (i-1/2)*dlon_deg (lon0_deg is the west edge, hence the half-cell shift). The same formula Transport3D.lonp uses; both read lon0_deg, so they cannot drift apart. Only the diurnal/day-of-week lookups need it.",
          "shape": [
            "lon"
          ]
        },
        "tz_offset_h": {
          "type": "unknown",
          "units": "1",
          "description": "Timezone offset in hours, floor(lon_deg/15) -- one hour per 15 deg of longitude, as NEI2016MonthlyEmis does.",
          "shape": [
            "lon"
          ]
        },
        "t_local_utc": {
          "type": "unknown",
          "units": "s",
          "description": "Local solar time (Unix s) at each column: t + t_ref + tz_offset_h*3600.",
          "shape": [
            "lon"
          ]
        },
        "local_hour": {
          "type": "unknown",
          "units": "1",
          "description": "Local hour of day, 1..24 (1-based to index the diurnal tables).",
          "shape": [
            "lon"
          ]
        },
        "day_of_week": {
          "type": "unknown",
          "units": "1",
          "description": "Local ISO weekday 1..7 (Mon..Sun), from t_local_utc. The +3 offset is because Unix day 0 (1970-01-01) is a Thursday, ISO 4.",
          "shape": [
            "lon"
          ]
        },
        "diurnal_factor": {
          "type": "unknown",
          "units": "1",
          "description": "General diurnal profile (applied to CO and FORM). Table and lookup are NEI2016MonthlyEmis's.",
          "shape": [
            "lon"
          ]
        },
        "diurnal_factor_nox": {
          "type": "unknown",
          "units": "1",
          "description": "NOx diurnal profile (applied to NO and NO2). Table and lookup are NEI2016MonthlyEmis's verbatim, which are GasChem.jl's in turn. Read on the round(lon/15) clock (local_hour_round), as upstream.",
          "shape": [
            "lon"
          ]
        },
        "diurnal_factor_isop": {
          "type": "unknown",
          "units": "1",
          "description": "Isoprene diurnal profile: zero at night, peaking ~2.66 at midday. Table and lookup are NEI2016MonthlyEmis's verbatim, which are GasChem.jl's in turn. Read on the round(lon/15) clock (local_hour_round), as upstream.",
          "shape": [
            "lon"
          ]
        },
        "dayofweek_nox": {
          "type": "unknown",
          "units": "1",
          "description": "NOx day-of-week profile (reduced weekends). Table and lookup are NEI2016MonthlyEmis's verbatim, which are GasChem.jl's in turn. Read on the round(lon/15) clock (day_of_week_round), as upstream.",
          "shape": [
            "lon"
          ]
        },
        "dayofweek_co": {
          "type": "unknown",
          "units": "1",
          "description": "CO day-of-week profile, Monday-first: 1.1076 on all five weekdays, 0.779 Sat, 0.683 Sun (the week sums to 7), EarthSciML/EarthSciData.jl PR #226 (head jialinl6:Oct_merge @87f8da1).",
          "shape": [
            "lon"
          ]
        },
        "frac_ptegu": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Fraction of the ptegu profile's column released into layer gk (GEOS-Chem's 11-layer profile, Simpson et al. 2003 EMEP Table 4.1, renormalized): 0 above the profile or ktop, and the remainder of the column at ktop folded into it (upstream nei_layer_fraction). Broadcast over lon and lat, so a lane of the capacity build carries its own level."
        },
        "frac_ptnonipm": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Fraction of the ptnonipm profile's column released into layer gk (GEOS-Chem's 11-layer profile, Simpson et al. 2003 EMEP Table 4.1, renormalized): 0 above the profile or ktop, and the remainder of the column at ktop folded into it (upstream nei_layer_fraction). Broadcast over lon and lat, so a lane of the capacity build carries its own level."
        },
        "frac_pt_oilgas": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Fraction of the pt_oilgas profile's column released into layer gk (GEOS-Chem's 11-layer profile, Simpson et al. 2003 EMEP Table 4.1, renormalized): 0 above the profile or ktop, and the remainder of the column at ktop folded into it (upstream nei_layer_fraction). Broadcast over lon and lat, so a lane of the capacity build carries its own level."
        },
        "frac_cmv": {
