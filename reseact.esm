    },
    {
      "type": "variable_map",
      "from": "GEOSFP.V",
      "to": "Transport3D.F_V",
      "transform": "param_to_var",
      "description": "GEOS-FP A3dyn northward wind -> the meridional face flux My."
    },
    {
      "type": "variable_map",
      "from": "GEOSFP.OMEGA",
      "to": "Transport3D.F_OM",
      "transform": "param_to_var",
