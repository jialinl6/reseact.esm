        },
        "Rd_air": {
          "type": "parameter",
          "units": "J/(kg*K)",
          "default": 287.05,
          "description": "Gas constant for dry air, for the hydrostatic conversion of PBLH (metres) to a PBL-top PRESSURE."
        },
        "g_acc": {
          "type": "parameter",
          "units": "m/s^2",
          "default": 9.80665,
          "description": "Standard gravity, for the same conversion."
        },
        "tau_pblmix": {
          "type": "parameter",
          "units": "s",
          "default": 900.0,
          "description": "PBL mixing relaxation time. GEOS-Chem's full-mixing scheme replaces the PBL profile with its mass-weighted mean INSTANTANEOUSLY, once per dynamic timestep (10-15 min at 4x5). A continuous-time model cannot express an instantaneous projection, so the same operator is written as relaxation TOWARD that mean: the tau -> 0 limit IS complete mixing, and tau = 900 s reproduces GEOS-Chem's once-per-dynamic-step cadence. A finite tau is also far gentler on the stiff solver than a projection would be."
        },
        "p_pbl_top": {
          "type": "unknown",
          "units": "Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Pressure at the PBL top, from PBLH via the hydrostatic relation with the SURFACE-layer temperature: p = PS*exp(-PBLH*g/(Rd*T_sfc)). GEOS-Chem likewise converts its PBL depth into pressure units and does the mixing in pressure/mass space, which is what makes the operator exactly mass-conserving on a terrain-following grid."
        },
        "pbl_f": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Fraction of each layer lying inside the PBL -- GEOS-Chem's F_OF_PBL. Computed as the overlap of the layer's pressure interval [pe(k+1), pe(k)] with [p_pbl_top, PS], divided by the layer thickness, then clamped to [0,1]: layers wholly inside give 1, wholly above give 0, and the ONE straddling layer gets a partial weight. That partial weight is what stops the mixing depth from jumping discontinuously between levels as PBLH evolves."
        },
        "pbl_wt": {
          "type": "unknown",
          "units": "Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Total PBL mass per unit area (as pressure), sum_k dp_k * pbl_f_k -- the normaliser of the mass-weighted PBL mean. Guarded below by a small floor so a collapsed nocturnal PBL cannot divide by zero; where the PBL is that thin, pbl_f is ~0 in every layer anyway and the mixing tendency vanishes with it."
        },
        "pbl_sum_NO": {
          "type": "unknown",
          "units": "ppb*Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Mass-weighted PBL column integral of NO, sum_k dp_k*pbl_f_k*NO_k. Paired with pbl_wt it gives the PBL mean the full-mixing operator relaxes toward."
        },
        "pbl_sum_CO": {
          "type": "unknown",
          "units": "ppb*Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Mass-weighted PBL column integral of CO, sum_k dp_k*pbl_f_k*CO_k. Paired with pbl_wt it gives the PBL mean the full-mixing operator relaxes toward."
        },
        "pbl_sum_ISOP": {
          "type": "unknown",
          "units": "ppb*Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Mass-weighted PBL column integral of ISOP, sum_k dp_k*pbl_f_k*ISOP_k. Paired with pbl_wt it gives the PBL mean the full-mixing operator relaxes toward."
        },
        "pbl_sum_HNO3": {
          "type": "unknown",
          "units": "ppb*Pa",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Mass-weighted PBL column integral of HNO3, sum_k dp_k*pbl_f_k*HNO3_k. Paired with pbl_wt it gives the PBL mean the full-mixing operator relaxes toward."
        },
        "pbl_sum_NO2": {
          "type": "unknown",
          "units": "ppb*Pa",
          "shape": [
            "lon",
            "lat"
          ],
