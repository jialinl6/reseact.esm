            "lat",
            "lev"
          ]
        }
      },
      "equations": [
        {
          "lhs": "src_poly_xy",
          "rhs": {
            "op": "apply_expression_template",
            "name": "src.cartesian_cell_rings_poly",
            "args": [],
            "bindings": {
              "x0": "src_x0",
              "y0": "src_y0",
              "dx": "src_dx",
              "dy": "src_dy"
            }
          }
        },
        {
          "lhs": "src_poly",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "c",
              "v",
              "k"
            ],
            "ranges": {
              "c": {
                "from": "ov.src_cells"
              },
              "v": {
                "from": "ov.overlap_cell_verts"
              },
              "k": {
                "from": "ov.overlap_coord"
              }
            },
            "args": [
              "src_poly_xy"
            ],
            "expr": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<",
                  "args": [
                    "k",
                    2
                  ]
                },
                {
                  "op": "apply_expression_template",
                  "name": "lcc.lambert_conformal_inverse_lon",
                  "args": [],
                  "bindings": {
                    "x": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        1
                      ]
                    },
                    "y": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        2
                      ]
                    },
                    "lat_1": "lcc_lat_1",
                    "lat_2": "lcc_lat_2",
                    "lat_0": "lcc_lat_0",
                    "lon_0": "lcc_lon_0",
                    "R": "lcc_R"
                  }
                },
                {
                  "op": "apply_expression_template",
                  "name": "lcc.lambert_conformal_inverse_lat",
                  "args": [],
                  "bindings": {
                    "x": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        1
                      ]
                    },
                    "y": {
                      "op": "index",
                      "args": [
                        "src_poly_xy",
                        "c",
                        "v",
                        2
                      ]
                    },
                    "lat_1": "lcc_lat_1",
                    "lat_2": "lcc_lat_2",
                    "lat_0": "lcc_lat_0",
                    "lon_0": "lcc_lon_0",
                    "R": "lcc_R"
                  }
                }
              ]
            }
          }
        },
        {
          "lhs": "src_coslat",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "c"
            ],
            "ranges": {
              "c": {
                "from": "ov.src_cells"
              }
            },
            "args": [
              "src_poly"
            ],
            "expr": {
              "op": "cos",
              "args": [
                {
                  "op": "*",
                  "args": [
                    0.017453292519943295,
                    {
                      "op": "*",
                      "args": [
                        0.25,
                        {
                          "op": "+",
                          "args": [
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                1,
                                2
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                2,
                                2
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                3,
                                2
                              ]
                            },
                            {
                              "op": "index",
                              "args": [
                                "src_poly",
                                "c",
                                4,
                                2
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "tgt_poly",
          "rhs": {
            "op": "apply_expression_template",
            "name": "tgt.cartesian_cell_rings_poly",
            "args": [],
            "bindings": {
              "x0": "lon0_deg",
              "y0": {
                "op": "-",
                "args": [
                  "lat0_deg",
                  {
                    "op": "/",
                    "args": [
                      "dlat_deg",
                      2.0
                    ]
                  }
                ]
              },
              "dx": "dlon_deg",
              "dy": "dlat_deg"
            }
          }
        },
        {
