            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "F_FORM_cmv_c3": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 emln_cmv_c3_12 FORM on the native 12US1 grid, same layout and units as F_FORM (a monthly total in short tons per cell). Coupled from NEI2016Elevated.flux_FORM_cmv_c3.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "F_FORM_cmv_c1c2": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "NEI2016 emln_cmv_c1c2_12 FORM on the native 12US1 grid, same layout and units as F_FORM (a monthly total in short tons per cell). Coupled from NEI2016Elevated.flux_FORM_cmv_c1c2.",
          "shape": [
            "nei_t",
            "nei_lay",
            "nei_row",
            "nei_col"
          ]
        },
        "delp": {
          "type": "parameter",
          "units": "Pa",
          "default": 0.0,
          "description": "Pressure thickness (Pa) of every layer, coupled from Transport3D.dp = dA[k] + dB[k]*PS: the instantaneous hybrid thickness, whose layer 1 is the corrected first_level_pressure_thickness(PS). delp/g0 is each layer's air column mass (kg/m^2), the divisor that turns an emission flux into a mixing-ratio tendency. Upstream divides by EarthSciData's time-mean DRY thickness table instead (delp_dry_surface, and its hybrid extension aloft); the instantaneous total-air thickness is used here because it is the same air mass the transport carries.",
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "lev": {
          "type": "parameter",
          "units": "1",
          "default": 1.0,
          "description": "Vertical index k as a field, coupled from Transport3D.levc. The surface sectors go into layer 1 only (the gk < 2 gate); the elevated sectors are spread over layers 1-11 by their vertical profiles.",
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "src_poly_xy": {
          "type": "unknown",
          "units": "m",
          "description": "Source cell corner rings on the 12US1 Lambert grid, in metres, row-major over (row, col) with col fastest -- the same flattening the IOAPI array has in memory, so source cell c and F_*[1, 1, row(c), col(c)] name the same cell.",
          "shape": [
            "ov.src_cells",
            "ov.overlap_cell_verts",
            "ov.overlap_coord"
          ]
        },
        "src_poly": {
          "type": "unknown",
          "units": "deg",
          "description": "Source rings reprojected from Lambert metres to lon/lat, per vertex (Snyder eqs. 14-9/14-11 for lon, 15-5 for lat). Reprojecting the SOURCE rather than the target is 137,241x4 inverse projections against the target's 91x4 -- deliberately the expensive direction, because it is the one that stays correct when GEOS-FP is swapped for a higher-resolution product. Build-time only: measured at 244,837,944 node lowerings, 161 s, 1.36 GB peak, and the cascade tally comes back EMPTY -- none of this geometry reaches the per-step RHS.",
          "shape": [
            "ov.src_cells",
            "ov.overlap_cell_verts",
            "ov.overlap_coord"
          ]
        },
        "src_coslat": {
          "type": "unknown",
          "units": "1",
          "description": "cos(latitude) at each source cell centre, taken as the mean of its four reprojected ring latitudes. THIS IS THE AREA CORRECTION that makes a PLANAR degree-space overlap mass-conserving: clipping in (lon, lat) weights by dlon*dlat, but true area is R^2*cos(phi)*dlon*dlat, so a flux density premultiplied by cos(phi) and normalised by the cos-weighted target area (A_full) reproduces the spherical answer to the small-cell approximation. Without it a 12 km cell at 49N would be over-weighted ~1.5x relative to one at 25N.",
          "shape": [
            "ov.src_cells"
          ]
        },
        "tgt_poly": {
          "type": "unknown",
          "units": "deg",
          "description": "Target cell corner rings in lon/lat, row-major over (lat, lon) with lon fastest, so target cell j = (gj-1)*NLON + gi. x0 is lon0_deg (already a west EDGE) but y0 is lat0_deg - dlat_deg/2, because lat0_deg is the southern-most lat POINT.",
          "shape": [
            "ov.tgt_cells",
            "ov.overlap_cell_verts",
            "ov.overlap_coord"
          ]
        },
        "A_full": {
          "type": "unknown",
          "units": "deg^2",
          "description": "cos-weighted FULL area of each target cell: dlon * (sin(phi_N) - sin(phi_S)) * 180/pi. This is the normaliser the emissions apply divides by -- deliberately NOT conservative_overlap_A_j_gated, which row-sums the COVERED area only. The NEI domain does not tile the CONUS slice (ocean, Canada, Mexico), and normalising by covered area would smear a coastal cell's few covered source cells across the whole cell and multiply its emissions by the inverse coverage fraction. Dividing by the full cell area instead leaves the uncovered fraction correctly emitting nothing.",
          "shape": [
            "ov.tgt_cells"
          ]
        },
        "A_ij": {
          "type": "unknown",
          "units": "deg^2",
          "description": "Overlap area of every (source, target) pair that survives the join.overlap broad phase -- the 'overlap index' method: an STRtree over inflated ring bounding boxes admits a product term only for candidate pairs, so one polygon clip runs per candidate instead of per (i,j) of the 137,241 x 91 product. Planar manifold: the spherical clip needs the GeometryOps extension, and src_coslat/A_full already carry the area correction that matters at these latitudes.",
          "shape": [
            "ov.src_cells",
            "ov.tgt_cells"
          ]
        },
        "PHI_NO": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "NEI2016 NO flattened onto the source-cell enumeration and converted to a flux density (kg/m^2/s, still carrying the month's total rather than a daily rate -- the /days_in_month is applied on the target grid): file value (short tons per cell for the month) x 907.185/86400 (EarthSciData to_unit's `tons/day` scale) / (dx*dy), then x cos(lat) for the planar-overlap area correction. The remaining /days_in_month is applied on the target grid, where it is one scalar rather than 137,241 of them. Includes emln_othpt (Canada/Mexico points), which GEOS-Chem reads as 2-D, so it shares the surface layer and is added on the source grid before the regrid.",
          "shape": [
            "ov.src_cells"
          ]
        },
        "E_NO": {
          "type": "unknown",
          "units": "kg/m^2/s",
          "description": "NO flux density (month-total basis) conservatively regridded onto the target grid: sum_i A_ij * PHI_i / A_full_j over the gated candidate set.",
          "shape": [
            "ov.tgt_cells"
          ]
        },
        "PHI_NO_ptegu": {
