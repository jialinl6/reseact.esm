    "DryDepositionGas": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/wesley_dry_gas.esm"
    },
    "WetDeposition": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/wet_deposition.esm"
    },
    "SuperFastDepositionSink": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/superfast_deposition_sink.esm"
    },
    "WeselyLandUse": {
      "ref": "../EarthSciModels/components/atmospheric_deposition/wesely_landuse.esm"
    },
    "LandUseRemap": {
      "variables": {
        "lon0_deg": {
          "type": "parameter",
          "units": "deg",
          "default": -127.5,
          "description": "West EDGE of the target slice, in degrees. MUST equal Transport3D.lon0_deg (= -182.5 + 5*LON0 at 4x5); `native_slice` sets both from one origin, and likewise this model's dlon_deg/dlat_deg from the same resolution row. Disagreement puts the emissions on a different grid -- offset, or a different CELL SIZE -- than the meteorology, silently."
        },
        "lat0_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 26.0,
          "description": "Southern-most lat POINT of the target slice. MUST equal Transport3D.lat0_deg (= -90 + 4*LAT0 at 4x5). Note this is a cell CENTRE, so the ring builder below is handed lat0_deg - dlat_deg/2 as its south edge."
        },
        "dlon_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 5.0,
          "description": "Zonal cell width of the GEOS-FP grid the model is running on; MUST equal Transport3D.dlon_deg. The 5.0 default is 4x5; `native_slice(res=...)` sets this and Transport3D's copy from the same resolution row. It sizes the emissions TARGET cells the 12 km NEI inventory is conservatively regridded onto, so a stale value here silently regrids onto cells of the wrong area."
        },
        "dlat_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 4.0,
          "description": "Meridional cell width of the GEOS-FP grid the model is running on; MUST equal Transport3D.dlat_deg. The 4.0 default is 4x5; see dlon_deg."
        },
        "lu_lon_edge0": {
          "type": "parameter",
          "units": "deg",
          "default": -130.0,
          "description": "West edge of the land-use file's first column (window_lon_min)."
        },
        "lu_lat_edge0": {
          "type": "parameter",
          "units": "deg",
          "default": 20.0,
          "description": "South edge of the land-use file's first row (window_lat_min)."
        },
        "lu_dx": {
          "type": "parameter",
          "units": "deg",
          "default": 0.05,
          "description": "Land-use pixel width (cell_size)."
        },
        "lu_dy": {
          "type": "parameter",
          "units": "deg",
          "default": 0.05,
          "description": "Land-use pixel height (cell_size)."
        },
        "P_urban": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 1 (urban) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 1 (the runner reads `percent` with select indices [0]). Coupled from WeselyLandUse.f_urban; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_agricultural": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 2 (agricultural) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 2 (the runner reads `percent` with select indices [1]). Coupled from WeselyLandUse.f_agricultural; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_range": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 3 (range) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 3 (the runner reads `percent` with select indices [2]). Coupled from WeselyLandUse.f_range; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_deciduous": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 4 (deciduous) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 4 (the runner reads `percent` with select indices [3]). Coupled from WeselyLandUse.f_deciduous; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_coniferous": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 5 (coniferous) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 5 (the runner reads `percent` with select indices [4]). Coupled from WeselyLandUse.f_coniferous; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_mixedforest": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 6 (mixedforest) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 6 (the runner reads `percent` with select indices [5]). Coupled from WeselyLandUse.f_mixedforest; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_water": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 7 (water) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 7 (the runner reads `percent` with select indices [6]). Coupled from WeselyLandUse.f_water; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_barren": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 8 (barren) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 8 (the runner reads `percent` with select indices [7]). Coupled from WeselyLandUse.f_barren; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_wetland": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 9 (wetland) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 9 (the runner reads `percent` with select indices [8]). Coupled from WeselyLandUse.f_wetland; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_rangeag": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 10 (rangeag) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 10 (the runner reads `percent` with select indices [9]). Coupled from WeselyLandUse.f_rangeag; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "P_rockyshrubs": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "lu_class",
            "lu_lat",
            "lu_lon"
          ],
          "default": 0.0,
          "description": "MODIS MCD12C1 (2016) Wesely class 11 (rockyshrubs) PERCENTAGE (0..100, raw UInt8) on the 0.05 deg CONUS grid, the file's own [class, lat, lon] order with the class axis selected down to 11 (the runner reads `percent` with select indices [10]). Coupled from WeselyLandUse.f_rockyshrubs; the /100 is applied here, since the provider hands over the file's raw values."
        },
        "lonc": {
          "type": "unknown",
          "units": "deg",
          "shape": [
            "lon"
          ],
          "description": "Target cell centre longitude, lon0_deg + (i - 1/2)*dlon_deg."
        },
        "latc": {
          "type": "unknown",
          "units": "deg",
          "shape": [
            "lat"
          ],
          "description": "Target cell centre latitude, lat0_deg + (j - 1)*dlat_deg (the lat POINTS)."
        },
        "wlon": {
          "type": "unknown",
          "units": "deg",
          "shape": [
            "lon",
            "lu_wx"
          ],
          "description": "Longitude overlap (deg) of target cell i with land-use column i0(i) + wa - 1, i0(i) = max(1, floor((lon0_deg + (i - 1)*dlon_deg - lu_lon_edge0)/lu_dx) + 1) the first column it touches (upstream _overlap_range), max(0, min(hi) - max(lo)); zero past the file's last column."
        },
        "wlat": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lat",
            "lu_wy"
          ],
          "description": "Latitude overlap of target cell j with land-use row j0(j) + wb - 1 (j0 as i0, from the cell south edge lat0_deg + (j - 3/2)*dlat_deg) in sin(latitude), max(0, sin(min(hi)) - sin(max(lo))): the spherical area weight upstream's _overlap_1d(lat = true) uses."
        },
        "wsum_lon": {
          "type": "unknown",
          "units": "deg",
          "shape": [
            "lon"
          ],
          "description": "Sum of wlon over the window (the target cell's covered lon width)."
        },
        "wsum_lat": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lat"
          ],
          "description": "Sum of wlat over the window."
        },
        "fxy_urban": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat"
          ],
          "description": "Area fraction of Wesely class 1 (urban) on each target cell: the area-weighted mean of the 0.05 deg percentages / 100, sum over (wa, wb) of wlon*wlat*P/(100*wsum_lon*wsum_lat), upstream _remap_landuse (jialinl6/DepositionMTK.jl@cbe7d7db (branch superfast-gas-only) src/landuse_fractions.jl)."
        },
        "f_urban": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "fxy_urban broadcast down the column (DryDepositionGas reads it only at lev = 1). Coupled into DryDepositionGas.f_urban."
        },
        "fxy_agricultural": {
          "type": "unknown",
          "units": "1",
