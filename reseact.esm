          "type": "parameter",
          "units": "K",
          "shape": [
            "gf_t",
            "gf_lat",
            "gf_lon"
          ],
          "default": 0.0,
          "description": "GEOS-FP A1 surface skin temperature TS, two bracketing records, NATIVE [time,lat,lon]. A1 cadence -> blends with w_A1."
        },
